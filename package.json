{
  "name": "wordsteps",
  "version": "2.0.0",
  "description": "WordSteps 步步记词 - 桌面端单词学习工具",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "install-banks": "if not exist \"%APPDATA%\\wordsteps\\user-banks\\Szy\" mkdir \"%APPDATA%\\wordsteps\\user-banks\\Szy\" && xcopy /E /I /Y \"user-banks\\Szy\\*\" \"%APPDATA%\\wordsteps\\user-banks\\Szy\\\"",
    "build": "tsc && vite build && electron-builder",
    "build:unpack": "tsc && vite build && electron-builder --dir",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "esbuild-wasm": "^0.25.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "typescript": "^5.8.2",
    "vite": "^6.3.1",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
